    "js-beautify": "^1.15.4",
    "lucide-vue-next": "^0.475.0",
    "mermaid": "^11.4.1",
    "pinia": "^3.0.1",
    "reka-ui": "^2.2.0",
    "sql-formatter": "^15.4.9",
    "tailwind-merge": "^3.0.1",
    "tw-animate-css": "^1.2.5",
    "uuid": "^11.1.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.0.9",
